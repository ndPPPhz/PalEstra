# URL pubblico dell'app. Usato per costruire i link di invito che il PT
# manda agli atleti, quindi in produzione deve essere quello vero.
APP_URL=http://localhost:3000

DATABASE_URL=postgres://palestra:palestra@127.0.0.1:5432/palestra

# Invio delle email con i codici OTP di accesso.
# Se RESEND_API_KEY non e' impostata, il codice viene stampato nei log del
# server invece di essere inviato: comodo in sviluppo, da NON usare in
# produzione (chiunque legga i log potrebbe entrare come un altro utente).
RESEND_API_KEY=
MAIL_FROM=PalEstra <no-reply@palestra.annino.dev>
